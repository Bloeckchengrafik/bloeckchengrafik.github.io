---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import sailingPhoto from "../assets/sailing.png";
import cableCarPhoto from "../assets/seilbahn-cabins.png";

const posts = (await getCollection("blog")).sort(
    (a, b) =>
        b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
        a.id.localeCompare(b.id),
);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
if (!featuredPost) throw new Error("There are no articles to feature.");
const archivePosts = posts.filter((post) => post.id !== featuredPost.id);
const recentNotes = (await getCollection("labNotes"))
    .filter((note) => note.data.pubDate !== undefined)
    .sort(
        (a, b) =>
            b.data.pubDate!.valueOf() - a.data.pubDate!.valueOf() ||
            a.id.localeCompare(b.id),
    )
    .slice(0, 3);
const noteStatus = {
    open: "○ Open",
    resolved: "✓ Resolved",
    superseded: "↳ Superseded",
};
const articleDate = featuredPost.data.pubDate.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "Europe/Berlin",
});
---

<SiteLayout
    title="Bloeckchengrafik — Christian Bergschneider"
    description="Projects, lab notes, and articles by Christian Bergschneider."
>
    <section class="intro" aria-labelledby="identity">
        <div class="intro-person">
            <div class="kicker">Software / hardware / systems</div>
            <h1 id="identity">
                Christian
                <br />
                Bergschneider
            </h1>
            <p>
                Sailing somewhere in the aether between a fischertechnik cable
                car, Minecraft server software, and questionable tech.
            </p>
        </div>
        <div class="personal-snapshots">
            <figure class="sailing-photo">
                <Image
                    src={sailingPhoto}
                    format="webp"
                    alt="View from a sailing boat beneath white sails, with blue sky and a reed-lined waterway."
                />
            </figure>
            <aside class="current sticky">
                <h2>Currently</h2>
                <ul>
                    <li>figuring out mainframes at work</li>
                    <li>trying to drive a raw e-paper display with an FPGA</li>
                    <li>learning KiCad alongside it</li>
                    <li>working on Minestom tools with everbuild</li>
                    <li>failing to keep Linux boring</li>
                </ul>
            </aside>
        </div>
    </section>

    <section id="projects" class="projects" aria-labelledby="projects-title">
        <div class="section-head">
            <h2 id="projects-title">Projects</h2>
        </div>
        <div class="other-projects">
            <article id="seilbahn">
                <h3>ftSeilbahnProjekt</h3>
                <div class="project-body">
                    <figure class="installation-photo">
                        <Image
                            src={cableCarPhoto}
                            format="webp"
                            loading="lazy"
                            alt="Fischertechnik cable-car cabins with miniature passengers beneath a long station mechanism, with rollers and exposed wiring."
                        />
                    </figure>
                    <p>
                        Control software, deployment infrastructure, embedded
                        communication, and HMI software for a large
                        fischertechnik cable-car installation.
                    </p>
                    <p>
                        My work spans the operator interface, the backend, and
                        communication with the installation through ftSwarm.
                        Deployment and Linux device handling are part of the
                        same project: the software has to run on the hardware at
                        the exhibition.
                    </p>
                    <p class="project-links">
                        <a href="https://www.youtube.com/channel/UCiPkmxDNxz8hcTikRfCa6Yw">
                            Project videos
                        </a>
                    </p>
                    <div class="tags">
                        embedded · Rust · Linux · IoT · Solid · control systems
                    </div>
                </div>
            </article>
            <article>
                <h3>everbuild</h3>
                <div class="project-body">
                    <p>
                        I work on everbuild, a developer collective with
                        projects across Minecraft, server software, and
                        hardware. The public repositories include Minestom
                        libraries as well as an ESP32-based thermometer gateway.
                    </p>
                    <p class="project-links">
                        <a href="https://github.com/everbuild-org">
                            Repositories
                        </a>
                        <a href="https://everbuild.org">everbuild.org</a>
                    </p>
                </div>
            </article>
            <article id="epaper">
                <h3>Raw E-Paper / FPGA</h3>
                <div class="project-body">
                    <p>
                        I’m working on driving a raw e-paper display with an
                        FPGA and learning KiCad alongside it. The project
                        combines digital design with PCB work; the board split
                        is one of the questions I’m keeping in the lab notes.
                    </p>
                    <dl class="project-meta">
                        <div>
                            <dt>status</dt>
                            <dd>active experiment</dd>
                        </div>
                        <div>
                            <dt>started</dt>
                            <dd>2026</dd>
                        </div>
                        <div>
                            <dt>role</dt>
                            <dd>hardware + software</dd>
                        </div>
                        <div>
                            <dt>areas</dt>
                            <dd>FPGA / PCB / embedded</dd>
                        </div>
                    </dl>
                </div>
            </article>
            <article>
                <h3>Minestom ecosystem work</h3>
                <div class="project-body">
                    <figure class="terrain-photo">
                        <img
                            src="/terra-minestom-resources/screenshot1.webp"
                            width="2880"
                            height="1776"
                            loading="lazy"
                            alt="Terra-generated Minecraft terrain with trees above a rocky shoreline."
                        />
                        <figcaption>
                            Terra world generation running on Minestom.
                        </figcaption>
                    </figure>
                    <p>
                        I adapted Terra’s world generation to Minestom.
                        Generating terrain a chunk at a time was the
                        straightforward part; placing features meant dealing
                        with reads and writes across chunk boundaries. I wrote
                        up the integration and published the code through
                        everbuild.
                    </p>
                    <p class="project-links">
                        <a href="https://github.com/everbuild-org/Terra">
                            Terra integration
                        </a>
                        <a href="https://github.com/everbuild-org/blocks-and-stuff">
                            Blocks &amp; fluids
                        </a>
                    </p>
                </div>
            </article>
        </div>
    </section>

    <section id="lab-notes" class="notes" aria-labelledby="notes-title">
        <div class="section-head">
            <h2 id="notes-title">Lab Notes</h2>
            <a class="section-more" href="/lab-notes/">
                All notes →
            </a>
        </div>
        <div class="note-rows">
            {recentNotes.map((note) => (
                <article id={note.id}>
                    <span class:list={["status", note.data.status]}>
                        {noteStatus[note.data.status]}
                    </span>
                    <div>
                        <h3>
                            <a href={`/lab-notes/${note.id}/`}>
                                {note.data.title}
                            </a>
                        </h3>
                        <div class="meta">
                            {note.data.pubDate && (
                                <>
                                    <time
                                        datetime={note.data.pubDate.toISOString()}
                                    >
                                        {note.data.pubDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "long",
                                                year: "numeric",
                                                timeZone: "Europe/Berlin",
                                            },
                                        )}
                                    </time>{" "}
                                    ·{" "}
                                </>
                            )}
                            {note.data.tags.join(" · ")}
                        </div>
                        {note.data.project && (
                            <p class="connections">
                                Project:{" "}
                                <a href={note.data.project.href}>
                                    {note.data.project.label}
                                </a>
                            </p>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section id="articles" class="writing" aria-labelledby="writing-title">
        <div class="section-head">
            <h2 id="writing-title">Articles</h2>
        </div>
        <div class="writing-feature">
            <div class="writing-label">Featured</div>
            <article>
                <h3>
                    <a href={`/blog/${featuredPost.id}/`}>
                        {featuredPost.data.title}
                    </a>
                </h3>
                <p>{featuredPost.data.description}</p>
                <div class="writing-meta">
                    <time datetime={featuredPost.data.pubDate.toISOString()}>
                        {articleDate}
                    </time>
                </div>
                <a class="writing-read" href={`/blog/${featuredPost.id}/`}>
                    Read article →
                </a>
            </article>
        </div>
        <div class="writing-archive">
            <div class="writing-label">Archive</div>
            <div class="writing-list">
                {archivePosts.map((post) => (
                    <article>
                        <h3>
                            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                        </h3>
                        <p>{post.data.description}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>
</SiteLayout>
