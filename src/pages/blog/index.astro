---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout
  title="Articles — Bloeckchengrafik"
  description="Finished articles about software, experiments, and things learned along the way."
  mainClass="subpage"
>
  <section class="writing" aria-labelledby="articles-title">
    <div class="section-head"><h1 id="articles-title">Articles</h1></div>
    <div class="writing-list">
      {posts.map((post) => (
        <article>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <div>
            <p>{post.data.description}</p>
            <p class="writing-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time></p>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
