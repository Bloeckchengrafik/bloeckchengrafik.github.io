---
import SiteLayout from './SiteLayout.astro';
import PostComments from '../components/PostComments.astro';
import { authors as authorProfiles } from '../authors';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  authors: string[];
}

const { title, description, pubDate, updatedDate, heroImage, authors } = Astro.props;
const byline = authors.map((id) => authorProfiles[id as keyof typeof authorProfiles]?.name ?? id).join(', ');
---

<SiteLayout title={`${title} — Bloeckchengrafik`} description={description} image={heroImage} mainClass="article-page">
  <article>
    <header class="article-header">
      <div class="kicker">Article</div>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        {byline && <> · {byline}</>}
        {updatedDate && <> · updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></>}
      </div>
    </header>
    {heroImage && <figure class="article-hero"><img src={heroImage} alt="" /></figure>}
    <div class="article-body"><slot /></div>
    <PostComments />
  </article>
</SiteLayout>
